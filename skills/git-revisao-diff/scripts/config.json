{
  "patterns": {
    "Unresolved merge conflict": {"regex": "(<<<<<<<|>>>>>>>)", "severity": "block"},
    "Debug breakpoint": {"regex": "(debugger;|pdb\\.set_trace|breakpoint\\(\\)|binding\\.pry|dd\\(|var_dump\\()", "severity": "block"},
    "Debug log": {"regex": "(?i)(console\\.(log|debug|dir)|System\\.out\\.print|fmt\\.Print|\\bprint\\()", "severity": "warning"},
    "Pending marker": {"regex": "\\b(TODO|FIXME|XXX|HACK)\\b", "severity": "warning"},
    "Test skip": {"regex": "(?i)(\\.only\\(|\\.skip\\(|xit\\(|xdescribe\\(|@pytest\\.mark\\.skip)", "severity": "warning"}
  },
  "block_on": ["block"]
}
