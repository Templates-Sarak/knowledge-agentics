{
  "patterns": {
    "Dynamic eval/Function": {"regex": "(?i)\\b(eval|new\\s+Function)\\s*\\(", "confidence": "high"},
    "Command injection (Node)": {"regex": "(?i)\\b(exec|execSync)\\s*\\(", "confidence": "medium"},
    "Command injection (Python)": {"regex": "(?i)(os\\.system\\s*\\(|subprocess\\.[A-Za-z]+\\([^)]*shell\\s*=\\s*True|os\\.popen\\s*\\()", "confidence": "medium"},
    "XSS sink (innerHTML/dangerouslySetInnerHTML)": {"regex": "(?i)(innerHTML|outerHTML|dangerouslySetInnerHTML|document\\.write\\s*\\()", "confidence": "medium"},
    "Weak crypto (MD5/SHA1/DES/ECB)": {"regex": "(?i)(createHash\\(['\"](md5|sha1)['\"]\\)|\\bDES-|\\bECB\\b|hashlib\\.(md5|sha1)\\s*\\()", "confidence": "medium"},
    "Insecure random for token": {"regex": "(?i)Math\\.random\\s*\\(", "confidence": "low"},
    "Insecure deserialization": {"regex": "(?i)(pickle\\.loads\\s*\\(|yaml\\.load\\s*\\(|unserialize\\s*\\(|Marshal\\.load\\s*\\()", "confidence": "high"},
    "Path traversal literal": {"regex": "\\.\\./\\.\\.", "confidence": "low"},
    "SSRF (request with variable)": {"regex": "(?i)(requests\\.(get|post)|axios|fetch)\\s*\\(\\s*[a-zA-Z_$]", "confidence": "low"}
  },
  "extensions": [".js", ".ts", ".jsx", ".tsx", ".py", ".go", ".java", ".rb", ".php"],
  "ignore_dirs": ["node_modules", ".git", "dist", "build", ".next", ".venv", "venv", "__pycache__"]
}
