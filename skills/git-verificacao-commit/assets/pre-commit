#!/bin/sh
# pre-commit — gate de segredos do ecossistema Sarak (skill git-verificacao-commit).
# Instalado pela git-commit-inicial. Roda em TODO `git commit` e bloqueia se houver
# segredo ou arquivo sensível no que está staged. O script viaja com o repo em .githooks/.

if command -v python >/dev/null 2>&1; then PY=python; else PY=python3; fi

"$PY" .githooks/verify_commit.py --root .
status=$?

if [ "$status" -ne 0 ]; then
  echo ""
  echo "⛔ COMMIT BLOCKED — secret or sensitive file detected in the staged changes (see above)."
  echo "   • Fix it: move the secret to .env (and add it to .gitignore) and re-stage."
  echo "   • History/branches: run the git-especialista-repositorio skill."
  echo "   • False positive? Adjust .githooks/config.json (allowlist)."
  exit 1
fi
exit 0
