# <INFRA_DIR>/.env.example — as chaves que SÓ o compose lê (copie para <INFRA_DIR>/.env e preencha).
#
# POR QUE NÃO ESTÃO NO .env DA RAIZ: o `node tools/sync-env.mjs` (roda a cada create-module) regrava o
# .env da raiz a partir dos manifestos (project.json e module.json) e MOVE para a seção ORFAS, comentada,
# toda chave que nenhum manifesto exige. Estas chaves nenhum código lê — só o compose —, então não podem
# ser declaradas como ROOT_* (a regra env-raiz-declarado acusaria "declarada e sem leitor"). Moram aqui.
#
# O .env REAL (<INFRA_DIR>/.env) é gitignored (o padrão `.env` do .gitignore da raiz casa em qualquer
# pasta) e fora do contexto de build (`**/.env` no .dockerignore). Este exemplo é versionado e SEM valor real.
#
# Uso: docker compose --env-file .env --env-file <INFRA_DIR>/.env ...   (o segundo vence em conflito;
# exige Docker Compose 2.23+). O .env da raiz continua a fonte de ROOT_API_PORT e dos <MODULE>_*.

# --- Postgres de dev (compose.yml) ---
DEPLOY_DB_NAME=
DEPLOY_DB_USER=
DEPLOY_DB_PASSWORD=
# Porta publicada em 127.0.0.1. No Windows, escolha fora das faixas reservadas
# (netsh interface ipv4 show excludedportrange protocol=tcp).
DEPLOY_DB_PORT=

# --- Front em loopback (profile `app`) ---
DEPLOY_FRONT_PORT=

# --- Produção (compose.production.yml — no servidor; ver references/producao.md) ---
DEPLOY_REGISTRY=
DEPLOY_APP_DIGEST=
DEPLOY_FRONT_DIGEST=
DEPLOY_STOP_GRACE_PERIOD=
