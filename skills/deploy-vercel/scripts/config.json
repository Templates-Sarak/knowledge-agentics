{
  "build_config_files": ["vercel.json", "next.config.js", "next.config.ts", "next.config.mjs", "package.json"],
  "forbidden_secret_files": [".env", ".env.local", ".env.production", "*.pem"],
  "secret_patterns": ["(?i)(secret|password|passwd|api[_-]?key|token)[\"'\\s]*[:=]", "(?i)://[^\\s\"']+:[^\\s\"']+@"],
  "env_example": ".env.example",
  "ignore_dirs": ["node_modules", ".git", "dist", "build", ".venv"]
}
