{
  "junk_name_patterns": ["*.log", "*.tmp", "*.swp", "*.bak", "*~"],
  "junk_dirs": ["old", "backup", "legacy", "_bkp", "temp", "tmp", "v1_trash"],
  "markers": ["console.log", "debugger", "TODO", "FIXME", "XXX"],
  "code_extensions": [".js", ".ts", ".jsx", ".tsx", ".py", ".go", ".java", ".rb", ".php"],
  "ignore_dirs": ["node_modules", ".git", "dist", "build", ".venv", "venv", "__pycache__"],
  "large_size_bytes": 5000000
}
