{
  "_source": "Tunables of validate_docker.py (zero-hardcoded). Each project may adjust globs/lists.",
  "dockerfile_globs": ["Dockerfile", "Dockerfile.*", "*.Dockerfile"],
  "build_secret_names": [
    "secret", "password", "passwd", "api_key", "apikey", "token", "private_key",
    "access_key", "client_secret", "credential"
  ],
  "ignore_dirs": [".git", "node_modules", "dist", "build", "target", ".venv", "venv", "__pycache__"]
}
