{
  "$comentario": "Forma do module.json. Lei dona: specs/arquitetura/01-modulo.md §3. Campo nao previsto REPROVA: o manifesto e contrato, e contrato nao aceita campo inventado em silencio.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id", "name", "version", "description", "role", "binding", "basePath", "webPath",
    "data", "requiredEnv", "ports", "consumes", "ui", "permissions",
    "publicRoutes", "sensitiveFields", "navigation", "exportsSummary", "generatesArtifact"
  ],
  "properties": {
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
    "name": { "type": "string", "minLength": 1 },
    "version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
    "description": { "type": "string", "minLength": 1 },
    "role": { "type": "string", "enum": ["domain", "gateway", "connector"] },
    "binding": { "type": "string", "enum": ["typescript", "javascript", "python"] },
    "basePath": { "type": "string", "pattern": "^/api/v1/[a-z][a-z0-9-]*$" },
    "webPath": { "type": ["string", "null"], "pattern": "^/[a-z][a-z0-9-]*$" },

    "data": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema", "prefix", "tables"],
      "properties": {
        "schema": { "type": "string", "minLength": 1 },
        "prefix": { "type": "string", "pattern": "^[a-z][a-z0-9_]*_$" },
        "tables": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" }
        }
      }
    },

    "requiredEnv": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]*$" }
    },

    "ports": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": ["repositorio", "auditoria", "relogio", "geradorId", "storage", "verificadorDeToken", "notificador"]
      }
    },

    "consumes": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["module", "contract", "why"],
        "properties": {
          "module": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
          "contract": { "type": "string", "pattern": "^(GET|POST|PATCH|PUT|DELETE) /" },
          "why": { "type": "string", "minLength": 1 }
        }
      }
    },

    "ui": {
      "type": "object",
      "additionalProperties": false,
      "required": ["modo"],
      "properties": {
        "modo": { "type": "string", "enum": ["proprio", "kit"] },
        "pacote": { "type": "string", "minLength": 1 }
      }
    },

    "permissions": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^[a-z][a-z0-9-]*:[a-z]+$" }
    },

    "publicRoutes": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^(GET|POST|PATCH|PUT|DELETE) /" }
    },

    "sensitiveFields": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },

    "navigation": {
      "oneOf": [
        { "type": "null" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["label", "icon", "order"],
          "properties": {
            "label": { "type": "string", "minLength": 1 },
            "icon": { "type": "string", "minLength": 1 },
            "order": { "type": "integer", "minimum": 0 }
          }
        }
      ]
    },

    "exportsSummary": { "type": "boolean" },
    "generatesArtifact": { "type": "boolean" }
  }
}
