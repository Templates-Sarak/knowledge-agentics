{
  "$comment": "Cadeia de seguranca da api. Lei dona: specs/arquitetura/03-operacao.md §2.1. `allowedOrigins` nunca contem '*' — cobrado pela regra `cors-aberto`.",
  "type": "object",
  "additionalProperties": false,
  "required": ["rateLimit", "cors", "headers"],
  "properties": {
    "rateLimit": {
      "type": "object",
      "additionalProperties": false,
      "required": ["windowSeconds", "readLimit", "writeLimit"],
      "properties": {
        "windowSeconds": { "type": "integer", "minimum": 1 },
        "readLimit": { "type": "integer", "minimum": 1 },
        "writeLimit": { "type": "integer", "minimum": 1 },
        "generateLimit": { "type": "integer", "minimum": 1 }
      }
    },
    "cors": {
      "type": "object",
      "additionalProperties": false,
      "required": ["allowedOrigins", "methods"],
      "properties": {
        "allowedOrigins": { "type": "array", "uniqueItems": true, "items": { "type": "string" } },
        "methods": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "enum": ["GET", "POST", "PATCH", "PUT", "DELETE", "OPTIONS"] }
        }
      }
    },
    "headers": {
      "type": "object",
      "additionalProperties": false,
      "required": ["hsts", "noSniff", "frameDeny", "referrerPolicy"],
      "properties": {
        "hsts": { "type": "boolean" },
        "noSniff": { "type": "boolean" },
        "frameDeny": { "type": "boolean" },
        "referrerPolicy": {
          "type": "string",
          "enum": ["no-referrer", "same-origin", "strict-origin", "strict-origin-when-cross-origin"]
        }
      }
    }
  }
}
