# deploy/.env.example — as chaves que SÓ o compose lê (copie para deploy/.env e preencha).
#
# POR QUE NÃO ESTÃO NO .env DA RAIZ: o `node tools/sync-env.mjs` (roda a cada create-module) regrava o
# .env da raiz a partir dos manifestos (project.json e module.json) e MOVE para a seção ORFAS, comentada,
# toda chave que nenhum manifesto exige. Estas chaves nenhum código lê — só o compose —, então não podem
# ser declaradas como ROOT_* (a regra `root-env-declared` acusaria "declarada e sem leitor"). Moram aqui
# (ADR-022).
#
# O .env REAL (deploy/.env) é gitignored (o padrão `.env` do .gitignore da raiz casa em qualquer pasta)
# e fora do contexto de build (`**/.env` no .dockerignore). Este exemplo é versionado e SEM valor real.
#
# Uso: node tools/docker-up.mjs up   (passa os dois --env-file na ordem certa: o segundo vence em
# conflito; exige Docker Compose 2.23+). O .env da raiz continua a fonte de ROOT_API_PORT e dos <MODULE>_*.

# --- Postgres de dev (compose.yml) ---
DEPLOY_DB_NAME=
DEPLOY_DB_USER=
# Caractere especial na senha precisa de percent-encoding: ela entra numa URL (postgres://...).
DEPLOY_DB_PASSWORD=
# Porta publicada em 127.0.0.1. No Windows, escolha fora das faixas reservadas
# (netsh interface ipv4 show excludedportrange protocol=tcp).
DEPLOY_DB_PORT=

# --- A API em loopback (profile `app`; o binding Python não tem front) ---
DEPLOY_APP_PORT=

# --- Rótulo da imagem (opcional: o commit curto; vazio deixa o rótulo vazio) ---
DEPLOY_IMAGE_VERSION=
