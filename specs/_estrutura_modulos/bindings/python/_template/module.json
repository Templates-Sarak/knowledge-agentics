{
  "id": "<modulo>",
  "name": "<Modulo>",
  "version": "0.1.0",
  "description": "Descreva em uma linha o dominio de negocio deste modulo.",
  "role": "domain",
  "binding": "python",
  "basePath": "/api/v1/<modulo>",
  "webPath": null,
  "data": {
    "schema": "<escopo>",
    "prefix": "<modulo>_",
    "tables": [
      "<modulo>_migrations",
      "<modulo>_metadados",
      "<modulo>_auditoria"
    ]
  },
  "requiredEnv": [
    "<MODULO>_API_PORT",
    "<MODULO>_DB_URL"
  ],
  "ports": [
    "repositorio",
    "auditoria",
    "relogio",
    "geradorId",
    "notificador"
  ],
  "consumes": [],
  "ui": {
    "modo": "proprio"
  },
  "permissions": [
    "<modulo>:ler",
    "<modulo>:escrever"
  ],
  "publicRoutes": [
    "GET /health",
    "GET /meta",
    "GET /resumo"
  ],
  "sensitiveFields": [],
  "navigation": null,
  "exportsSummary": true,
  "generatesArtifact": true
}
