{
  "_comentario": "Cadeia de seguranca da api (specs/arquitetura/03-operacao.md §2.1). CORS nunca usa '*'.",
  "rateLimit": {
    "janelaSegundos": 60,
    "limiteLeitura": 120,
    "limiteEscrita": 20
  },
  "cors": {
    "origensPermitidas": [],
    "metodos": [
      "GET",
      "POST",
      "PATCH",
      "DELETE"
    ]
  },
  "headers": {
    "hsts": true,
    "noSniff": true,
    "frameDeny": true,
    "referrerPolicy": "no-referrer"
  }
}
