{
  "_comment": "Cadeia de seguranca da api (specs/arquitetura/03-operacao.md §2.1). CORS nunca usa '*'.",
  "rateLimit": {
    "windowSeconds": 60,
    "readLimit": 120,
    "writeLimit": 20
  },
  "cors": {
    "allowedOrigins": [],
    "methods": [
      "GET",
      "POST",
      "PATCH",
      "DELETE"
    ]
  },
  "headers": {
    "hsts": true,
    "noSniff": true,
    "frameDeny": true,
    "referrerPolicy": "no-referrer"
  }
}
